# Csupor Craft Beer — environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed (CEF: secrets are never stored in the repository).

# --- Public site --------------------------------------------------------------
# The canonical origin. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://csuporcraftbeer.com

# --- Admin panel --------------------------------------------------------------
# The single operator account for /admin.
ADMIN_USERNAME=csupor

# Minimum 12 characters. Use a password manager to generate one.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Signs the admin session JWT. Minimum 32 characters — the app refuses to
# authenticate without it rather than falling back to a guessable default.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32

# --- Storage ------------------------------------------------------------------
# Where the beer list is persisted. In Docker this is the mounted named volume;
# locally it defaults to ./data when unset.
DATA_DIR=/data
